# Azure IoT Device Provisioning Service (DPS) Configuration
# Copy this file to .env and fill in your actual values

# DPS provisioning host endpoint
# Example: global.azure-devices-provisioning.net
PROVISIONING_HOST=

# DPS ID Scope - found in your DPS instance overview
# Example: 0ne00ABCDEF
PROVISIONING_IDSCOPE=

# Device registration ID - unique identifier for your device
# This will be used as the Common Name (CN) in the certificate
PROVISIONING_REGISTRATION_ID=

# DPS Symmetric Key (for symmetric key authentication)
PROVISIONING_SAS_KEY=

# Azure Blob Storage Configuration
# Used for storing device data and counters

# Storage Account Connection String (Option 1)
# If provided, will use connection string authentication
# Example: DefaultEndpointsProtocol=https;AccountName=myaccount;AccountKey=...
STORAGE_CONN_STR=

# Storage Account URL (Option 2)
# If STORAGE_CONN_STR is not provided, will use DefaultAzureCredential
# Example: https://myaccount.blob.core.windows.net
STORAGE_ACCOUNT_URL=

# Storage Container Name
# Default: scale
STORAGE_CONTAINER_NAME=scale

# Counter Blob Prefix
# Prefix for counter blobs in storage
# Default: counter
COUNTER_BLOB_PREFIX=counter

# Device Data Blob Prefix
# Prefix for device data blobs in storage
# Default: data
DEVICE_DATA_BLOB_PREFIX=data

# Message Configuration
# Size of telemetry messages sent to IoT Hub in bytes
# Default: 256
HUB_MESSAGE_SIZE=256

# Multi-Hub Configuration (for MultiHubUser with Azure Load Testing)
# These variables are auto-provided by Azure Load Testing, but can be set manually for local testing

# Engine index (0 to N-1) - auto-provided by Azure Load Testing as AZURE_LOAD_TEST_ENGINE_INSTANCE
# Engines are grouped by hub: engines 0 to (ENGINES_PER_HUB-1) target hub 0, etc.
# Default: 0
# AZURE_LOAD_TEST_ENGINE_INSTANCE=0

# Total number of engines - auto-provided by Azure Load Testing as AZURE_LOAD_TEST_ENGINE_COUNT
# Should equal: number_of_hubs * ENGINES_PER_HUB
# Example: 5 hubs * 5 engines/hub = 25 total engines
# Default: 1
# AZURE_LOAD_TEST_ENGINE_COUNT=1

# Number of engines assigned to each hub
# Engines are grouped: engines 0-4 → hub 0, engines 5-9 → hub 1, etc.
# Default: 1
ENGINES_PER_HUB=5

# Total devices per engine - each engine manages this many devices
# Device IDs are hierarchically assigned: hub_index determines range, engine_index_within_hub determines offset
# Example with 5 hubs, 5 engines/hub, 100K devices/engine:
#   - Hub 0: devices 0 - 499,999 (engines 0-4)
#   - Hub 1: devices 500,000 - 999,999 (engines 5-9)
# Default: 100000
DEVICES_PER_ENGINE=100000
